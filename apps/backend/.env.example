# =============================================================================
# LAUNDELLE CENTRALIZED BACKEND — Environment Variables
# =============================================================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/laundelle_production
MONGODB_DB_NAME=laundelle_production

# JWT Authentication Secret
JWT_SECRET=

# Stripe Payments & Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Gemini AI Key (Laundry stain assistant)
GEMINI_API_KEY=

# Twilio SMS & WhatsApp OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Super Administrator Seed & Bootstrap
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_SUB=

# App / Client URLs & Allowed CORS Origins
APP_URL=https://customer.laundelle.co.uk
ADMIN_URL=https://admin.laundelle.co.uk
OPERATIONS_URL=https://ops.laundelle.co.uk
ALLOWED_ORIGINS=https://customer.laundelle.co.uk,https://ops.laundelle.co.uk,https://admin.laundelle.co.uk,https://laundelle.co.uk,https://www.laundelle.co.uk

# Auth0 Authentication, Backend API Audience & Management API (Server-Side ONLY)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.laundelle.co.uk
AUTH0_CLIENT_ID=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_MANAGEMENT_AUDIENCE=
AUTH0_DB_CONNECTION=Username-Password-Authentication
