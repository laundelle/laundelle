# =============================================================================
# LAUNDELLE CUSTOMER FRONTEND — Environment Variables
# =============================================================================

# Centralized Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Stripe publishable key used by Stripe.js in the in-app payment form. Never put
# the Stripe secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:4000

# Auth0 Configuration
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-client-id
