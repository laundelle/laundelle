# ==========================================
# LAUNDELLE - Full Stack .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables / Secrets
# ------------------------------------------
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Keep example environment files
!.env.example
!.env.sample


# ------------------------------------------
# Dependencies
# ------------------------------------------
node_modules/
**/node_modules/


# ------------------------------------------
# Next.js
# ------------------------------------------
.next/
**/.next/

out/
**/out/

.next/cache/
**/.next/cache/


# ------------------------------------------
# Production builds
# ------------------------------------------
dist/
**/dist/

build/
**/build/


# ------------------------------------------
# TypeScript
# ------------------------------------------
*.tsbuildinfo
**/*.tsbuildinfo


# ------------------------------------------
# Logs
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ------------------------------------------
# Runtime files
# ------------------------------------------
*.pid
*.pid.lock
*.seed
*.pidstore


# ------------------------------------------
# Testing / Coverage
# ------------------------------------------
coverage/
.nyc_output/
**/coverage/

playwright-report/
test-results/

# Jest
.jest/
jest-cache/


# ------------------------------------------
# Cache
# ------------------------------------------
.cache/
**/.cache/

.parcel-cache/
.turbo/
.vercel/cache/


# ------------------------------------------
# Vercel
# ------------------------------------------
.vercel/


# ------------------------------------------
# Render
# ------------------------------------------
# Render configuration is normally managed
# through the dashboard, but ignore local
# generated/runtime files.
.render/


# ------------------------------------------
# MongoDB / Local Database
# ------------------------------------------
data/
db/
mongodb-data/

*.db
*.sqlite
*.sqlite3


# ------------------------------------------
# Uploaded / Generated Files
# ------------------------------------------
uploads/
tmp/
temp/

*.tmp
*.temp


# ------------------------------------------
# OS Generated Files
# ------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Linux
*~


# ------------------------------------------
# IDE / Editors
# ------------------------------------------

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# Cursor
.cursor/

# JetBrains
.idea/
*.iml
*.iws
*.ipr

# Sublime
*.sublime-workspace
*.sublime-project


# ------------------------------------------
# Local Development
# ------------------------------------------
.local/
.localenv/

*.local


# ------------------------------------------
# Certificates / Private Keys
# ------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx

# Exception: public certificates if intentionally committed
!public/**/*.pem
!public/**/*.crt


# ------------------------------------------
# Docker
# ------------------------------------------
.docker/
docker-data/

# Local Docker environment
docker-compose.override.yml


# ------------------------------------------
# Package Manager
# ------------------------------------------
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.yarn/build-state.yml


# ------------------------------------------
# ESLint / Prettier caches
# ------------------------------------------
.eslintcache
.prettiercache


# ------------------------------------------
# Storybook
# ------------------------------------------
storybook-static/


# ------------------------------------------
# Generated API / Codegen
# ------------------------------------------
.openapi/
.codegen/


# ------------------------------------------
# Miscellaneous
# ------------------------------------------
*.swp
*.swo
*.bak
*.orig

.DS_Store