{
  "name": "laundelle",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:customer": "turbo dev --filter=customer",
    "dev:operations": "turbo dev --filter=operations",
    "dev:admin": "turbo dev --filter=admin",
    "dev:backend": "turbo dev --filter=backend",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "migrate:images": "npx tsx scripts/migrate-images-to-cloudinary.ts"
  },
  "devDependencies": {
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "image-size": "^2.0.4",
    "turbo": "^2.11.4",
    "typescript": "^5.7.0"
  }
}