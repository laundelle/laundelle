# =============================================================================
# LAUNDRY2U26 — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to source control.
# =============================================================================

# --- Google Gemini AI ---
# Required for the AI Laundry Care Guide / stain assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# --- App URL ---
# The base URL where this app is hosted (used for OAuth callbacks etc.)
APP_URL=

# --- Supabase Database & Auth ---
# Get these from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase Service Role Key (Server-Side ONLY — never expose to browser) ---
# Used for admin operations, webhooks, and Stripe callbacks on the backend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe Payments ---
# Get these from: Stripe Dashboard → Developers → API Keys
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PostHog Analytics (Optional) ---
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=

# --- SendGrid / Email (Optional) ---
# SENDGRID_API_KEY=
# FROM_EMAIL=

# --- Twilio SMS/WhatsApp (Optional for Phase 3) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# --- Auth0 Authentication ---
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
