# =============================================================================
# LAUNDELLE — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to source control.
# =============================================================================

# --- Database (MongoDB) ---
MONGODB_URI=mongodb://localhost:27017/laundelle_production
MONGODB_DB_NAME=laundelle_production

# --- JWT Signing Secret (Backend Local Sessions) ---
JWT_SECRET=

# --- Google Gemini AI ---
# Required for the AI Laundry Care Guide / stain assistant.
GEMINI_API_KEY=

# --- App URLs & Allowed CORS Origins ---
APP_URL=https://customer.laundelle.co.uk
ADMIN_URL=https://admin.laundelle.co.uk
OPERATIONS_URL=https://ops.laundelle.co.uk
NEXT_PUBLIC_APP_URL=https://customer.laundelle.co.uk
ALLOWED_ORIGINS=https://customer.laundelle.co.uk,https://ops.laundelle.co.uk,https://admin.laundelle.co.uk,https://laundelle.co.uk,https://www.laundelle.co.uk

# --- Stripe Payments ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Twilio SMS/WhatsApp (Optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Super Administrator Bootstrap ---
ADMIN_EMAIL=
ADMIN_NAME=System Administrator
ADMIN_PHONE=
BOOTSTRAP_ADMIN_SUB=

# --- Auth0 Frontend SPA Authentication (Public) ---
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.laundelle.co.uk

# --- Auth0 Backend API & M2M Management API (Server-Side ONLY - NEVER prefix with NEXT_PUBLIC_) ---
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.laundelle.co.uk
AUTH0_CLIENT_ID=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_MANAGEMENT_AUDIENCE=
AUTH0_DB_CONNECTION=Username-Password-Authentication

# --- Cloudinary Image Hosting & Optimisation ---
# Public cloud name for Next.js image delivery
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Server-side ONLY upload/admin credentials - NEVER prefix with NEXT_PUBLIC_
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
